@page "/roster"

@using DiscordTrain.Common.Commands
@using DiscordTrain.Common.Model


<h3>Roster</h3>
<MudTable T="IRosterEntry" Items="tableData" Hover="true">
    <HeaderContent>
        <MudTh>Engine Id</MudTh>
        <MudTh>Name</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Guild Id">@context.Id</MudTd>
        <MudTd DataLabel="User Id">@context.Name</MudTd>
    </RowTemplate>
</MudTable>
@code {

    [Inject]
    IServiceScopeFactory ServiceScopeFactory { get; set; } = null!;

    List<IRosterEntry> tableData = new List<IRosterEntry>();

    override protected async Task OnInitializedAsync()
    {
        await using var scope = ServiceScopeFactory.CreateAsyncScope();

        CancellationTokenSource cancellationTokenSource = new CancellationTokenSource();

        var tasks = scope.ServiceProvider.GetKeyedServices<IListRosterCommand>(KeyedService.AnyKey)
            .Select(x => x.ListRosterAsync(cancellationTokenSource.Token));
        
        var results = await Task.WhenAll(tasks);
        this.tableData = results.SelectMany(x => x).ToList();
    }

}
