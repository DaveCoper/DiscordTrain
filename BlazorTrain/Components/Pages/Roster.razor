@page "/roster"

@using DiscordTrain.Common.Commands
@using DiscordTrain.Common.Model

<PageTitle>Roster</PageTitle>

<h3>Roster</h3>
<MudTable T="ITrain" Items="tableData" Hover="true">
    <HeaderContent>
        <MudTh>Icon</MudTh>
        <MudTh>Engine Id</MudTh>
        <MudTh>Name</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="User Id">
            @if (!string.IsNullOrWhiteSpace(context.SmallIcon))
            {
                <img src="@FormatImagePath(context.Id)" style="max-width: 140px; max-height: 140px;" />
            }
        </MudTd>
        <MudTd DataLabel="Guild Id">@context.Id</MudTd>
        <MudTd DataLabel="User Id">@context.Name</MudTd>
    </RowTemplate>
</MudTable>
@code {

    [Inject]
    IServiceScopeFactory ServiceScopeFactory { get; set; } = null!;

    List<ITrain> tableData = [];

    override protected async Task OnInitializedAsync()
    {
        await using var scope = ServiceScopeFactory.CreateAsyncScope();

        CancellationTokenSource cancellationTokenSource = new CancellationTokenSource();

        var tasks = scope.ServiceProvider.GetKeyedServices<IListTrainsCommand>(KeyedService.AnyKey)
            .Select(x => x.GetTrainRosterAsync(cancellationTokenSource.Token));
        
        var results = await Task.WhenAll(tasks);
        this.tableData = results.SelectMany(x => x).ToList();
    }
    
    private string FormatImagePath(string id)
    {
        return $"/api/image/{id}";
    }
}
